{
  "$schema": "../../packages/packs/src/manifest.schema.json",
  "format": 1,
  "id": "demo",
  "name": "Demo",
  "summary": "A test pack with one kind, one viewer and one helper.",
  "description": "A tiny pack for tests: one extension kind, one viewer and one parameter helper.",
  "version": "0.1.0",
  "channel": "internal",
  "licence": "Apache-2.0",
  "requires": {
    "packApi": 1
  },
  "vocabularies": [
    {
      "name": "core"
    }
  ],
  "kinds": [
    {
      "name": "demo-tally",
      "label": "byte tally",
      "viewer": true,
      "paramHelper": true,
      "parser": "src/kinds/demo-tally/parse.ts"
    }
  ],
  "entries": {
    "worker": "src/worker.ts",
    "page": "src/page.ts"
  },
  "capabilities": {
    "effects": []
  },
  "budget": {
    "total": 40000,
    "worker": 30000,
    "page": 15000
  }
}
