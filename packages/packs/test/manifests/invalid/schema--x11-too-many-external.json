{
  "$schema": "../../packages/packs/src/manifest.schema.json",
  "format": 1,
  "id": "relix",
  "name": "Relix",
  "summary": "Build and run relational queries on your tables.",
  "description": "Relational algebra on tables: build queries as recipe steps and run them in the browser.",
  "version": "0.1.0",
  "channel": "stable",
  "licence": "Apache-2.0",
  "notice": "NOTICE",
  "requires": {
    "packApi": 1
  },
  "vocabularies": [
    {
      "name": "relix"
    }
  ],
  "kinds": [
    {
      "name": "relation",
      "label": "relation",
      "viewer": true,
      "paramHelper": false
    },
    {
      "name": "relix-expr",
      "label": "Relix expression",
      "viewer": false,
      "paramHelper": true,
      "parser": "src/kinds/relix-expr/shape.ts"
    }
  ],
  "conversions": [
    {
      "from": "table",
      "to": "relation",
