{
  "forge": 1,
  "steps": [
    {
      "kind": "fork",
      "split": {
        "value": "\n",
        "enc": "utf8"
      },
      "join": {
        "value": "0a",
        "enc": "hex"
      },
      "steps": [
        {
          "kind": "subsection",
          "pattern": "a",
          "steps": [
            {
              "kind": "if",
              "test": {
                "kind": "regex",
                "pattern": "b"
              },
              "then": [
                {
                  "kind": "repeat",
                  "times": 2,
                  "steps": [
                    {
                      "kind": "op",
                      "op": "text:upper"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
