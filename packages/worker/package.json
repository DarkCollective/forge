{
  "name": "@forge/worker",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/host-node.d.ts",
      "default": "./dist/host-node.js"
    },
    "./worker-web": {
      "types": "./dist/worker-web.d.ts",
      "default": "./dist/worker-web.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p harness/tsconfig.json --noEmit",
    "gate2:browser": "node scripts/gate2-browser.mjs",
    "gate4:browser": "node scripts/gate4-browser.mjs"
  },
  "dependencies": {
    "@forge/lang": "*",
    "@forge/ops": "*",
    "@forge/recipe": "*"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
