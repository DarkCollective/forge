{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:schema:help:1",
  "title": "Forge help document, format 1",
  "type": "object",
  "properties": {
    "format": {
      "const": 1
    },
    "catalogue": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "ops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/op"
      }
    }
  },
  "required": ["format", "catalogue", "version", "ops"],
  "additionalProperties": false,
  "$defs": {
    "qname": {
      "$ref": "https://forge.darkcollective.com/schemas/word-meta.schema.json#/$defs/qname"
    },
    "link": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*\\.[A-Za-z0-9-]*[A-Za-z][A-Za-z0-9-]*(?::[0-9]{1,5})?(?:[/?#][A-Za-z0-9\\-._~:/?#@!$&'()*+,;=%]*)?$"
        },
        "label": {
          "type": ["string", "null"],
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f]*$"
        }
      },
      "required": ["url", "label"],
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "note": {
          "type": ["string", "null"],
          "maxLength": 400
        },
        "ref": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "params": {
          "type": "object"
        },
        "input": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "maxLength": 2048
            },
            "enc": {
              "enum": ["utf8", "hex", "latin1", "base64"]
            }
          },
          "required": ["value", "enc"],
          "additionalProperties": false
        },
        "expect": {}
      },
      "required": ["title", "note", "ref", "params", "input", "expect"],
      "additionalProperties": false
    },
    "op": {
      "type": "object",
      "properties": {
        "qname": {
          "$ref": "#/$defs/qname"
        },
        "useWhen": {
          "type": ["string", "null"],
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f]*$"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "maxItems": 8
        },
        "inverse": {
          "oneOf": [
            {
              "$ref": "#/$defs/qname"
            },
            {
              "type": "null"
            }
          ]
        },
        "optionDocs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "maxItems": 3
        }
      },
      "required": ["qname", "useWhen", "links", "inverse", "examples"],
      "additionalProperties": false
    }
  }
}
