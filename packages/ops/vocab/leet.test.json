    "params": {
      "direction": "to"
    },
    "input": {
      "value": "fjk 0123 !? é 日本",
      "enc": "utf8"
    },
    "expect": {
      "value": "fjk 0123 !? é 日本",
      "enc": "utf8"
    }
  },
