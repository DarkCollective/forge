  {
    "name": "from leet, basic leaves 8 6 2",
    "ref": "8 6 2 are only in the extended table",
    "op": "leet:convert",
    "params": {
      "direction": "from",
      "style": "basic"
    },
    "input": {
      "value": "8 6 2 4",
      "enc": "utf8"
    },
    "expect": {
      "value": "8 6 2 a",
      "enc": "utf8"
    },
    "example": {
      "title": "Reading back is only a guess",
      "note": "From reads every 4 as an a, so the real digit 4 in 8 6 2 4 becomes a letter, which is why reading back is a best guess."
    }
  }
]
