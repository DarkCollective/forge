[
  {
    "name": "to leet, basic: the six letters a e i o s t",
    "ref": "a4 e3 i1 o0 s5 t7; b g z need the extended table",
    "op": "leet:convert",
    "params": {
      "direction": "to",
      "style": "basic"
    },
    "input": {
      "value": "abegiostz",
      "enc": "utf8"
    },
    "expect": {
      "value": "4b3g1057z",
      "enc": "utf8"
    }
  },
  {
    "name": "to leet, extended also has b g z",
    "ref": "a4 b8 e3 g6 i1 o0 s5 t7 z2",
    "op": "leet:convert",
    "params": {
      "direction": "to",
      "style": "extended"
    },
    "input": {
      "value": "abegiostz",
      "enc": "utf8"
    },
    "expect": {
      "value": "483610572",
      "enc": "utf8"
    },
    "example": {
      "title": "The extended style",
      "note": "The extended style also changes b, g, z and more, so abegiostz becomes 483610572."
    }
  },
  {
    "name": "to leet, in a sentence",
    "ref": "upper case letters without an entry keep their case",
    "op": "leet:convert",
    "params": {
      "direction": "to",
      "style": "basic"
    },
    "input": {
      "value": "Leet speak",
      "enc": "utf8"
    },
    "expect": {
      "value": "L337 5p34k",
      "enc": "utf8"
    },
    "example": {
      "title": "Basic leet speak",
      "note": "With the basic style a becomes 4, e becomes 3, i becomes 1, o becomes 0, s becomes 5 and t becomes 7, so Leet speak becomes L337 5p34k."
    }
  },
  {
    "name": "to leet, upper case input",
    "ref": "the table is applied to either case",
    "op": "leet:convert",
    "params": {
      "direction": "to",
      "style": "basic"
    },
    "input": {
      "value": "ELITE TESTS",
      "enc": "utf8"
    },
    "expect": {
      "value": "3L173 73575",
      "enc": "utf8"
    }
  },
  {
    "name": "to leet, extended",
    "ref": "c ( d ) h # l | q 9 x % on top of the basic table",
    "op": "leet:convert",
    "params": {
      "direction": "to",
      "style": "extended"
    },
    "input": {
      "value": "Hello World",
      "enc": "utf8"
    },
    "expect": {
      "value": "#3||0 W0r|)",
      "enc": "utf8"
    }
  },
  {
    "name": "to leet, unchanged characters",
