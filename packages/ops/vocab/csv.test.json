      "value": "name,age\r\nAda,36\r\nAlan,41\r\n",
      "enc": "utf8"
    },
    "example": {
      "title": "Objects become rows under one header",
      "note": "The keys of the objects make the header row, and each object is one row in that column order."
    }
  },
