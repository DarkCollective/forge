[
  {
    "name": "two columns, CRLF rows",
    "ref": "Python csv.DictReader/csv.reader and json.dumps",
    "op": "csv:to-json",
    "params": {
      "cell-delimiter": ",",
      "row-delimiter": "\\r\\n",
      "format": "array-of-dictionaries",
      "indent": 2
    },
    "input": {
      "value": "name,age\r\nAda,36\r\nAlan,41\r\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "[\n  {\n    \"name\": \"Ada\",\n    \"age\": \"36\"\n  },\n  {\n    \"name\": \"Alan\",\n    \"age\": \"41\"\n  }\n]",
      "enc": "utf8"
    },
    "example": {
      "title": "Rows read as objects keyed by the header",
      "note": "Every value comes out as text, so 36 is written as a string in the output."
    }
  },
  {
    "name": "RFC 4180: quoted cells hold commas, doubled quotes and line breaks",
    "ref": "Python csv.DictReader/csv.reader and json.dumps",
    "op": "csv:to-json",
    "params": {
      "cell-delimiter": ",",
      "row-delimiter": "\\r\\n",
      "format": "array-of-dictionaries",
      "indent": 2
    },
    "input": {
      "value": "a,b,c\r\n\"x,1\",\"he said \"\"hi\"\"\",\"line1\r\nline2\"\r\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "[\n  {\n    \"a\": \"x,1\",\n    \"b\": \"he said \\\"hi\\\"\",\n    \"c\": \"line1\\r\\nline2\"\n  }\n]",
      "enc": "utf8"
    }
  },
