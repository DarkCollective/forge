[
  {
    "name": "encode equals sign",
    "ref": "RFC 2045 section 6.7 rule 1 (= is =3D)",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "hello=world",
      "enc": "utf8"
    },
    "expect": {
      "value": "hello=3Dworld",
      "enc": "utf8"
    }
  },
  {
    "name": "encode UTF-8 e-acute",
    "ref": "RFC 2045 section 6.7 rule 1; hand-computed (c3 a9)",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "café",
      "enc": "utf8"
    },
    "expect": {
      "value": "caf=C3=A9",
      "enc": "utf8"
    }
  },
  {
    "name": "encode trailing white space",
    "ref": "RFC 2045 section 6.7 rule 3 (space and tab at line end)",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "a \r\nb\t",
      "enc": "utf8"
    },
    "expect": {
      "value": "a=20\r\nb=09",
      "enc": "utf8"
    }
  },
  {
    "name": "encode inner white space unchanged",
    "ref": "RFC 2045 section 6.7 rule 3",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "a b\tc",
      "enc": "utf8"
    },
    "expect": {
      "value": "a b\tc",
      "enc": "utf8"
    }
  },
  {
    "name": "encode empty input",
    "ref": "hand-computed (no bytes)",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "",
      "enc": "utf8"
    },
    "expect": {
      "value": "",
      "enc": "utf8"
    }
  },
  {
    "name": "encode binary 00 ff 0d",
    "ref": "RFC 2045 section 6.7 rule 1; lone CR is =0D",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "00ff0d",
      "enc": "hex"
    },
    "expect": {
      "value": "=00=FF=0D",
      "enc": "utf8"
    }
  },
  {
    "name": "encode CRLF and lone LF kept",
    "ref": "RFC 2045 section 6.7 rule 4 (hard line breaks)",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "a\r\nb\nc",
      "enc": "utf8"
    },
    "expect": {
      "value": "a\r\nb\nc",
      "enc": "utf8"
    }
  },
  {
    "name": "encode 76 characters, no soft break",
    "ref": "RFC 2045 section 6.7 rule 5 (76 characters per line)",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "enc": "utf8"
    },
    "expect": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "enc": "utf8"
    }
  },
  {
    "name": "encode 77 characters, soft break after 75",
    "ref": "RFC 2045 section 6.7 rule 5; cross-checked with Python binascii.b2a_qp",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "enc": "utf8"
    },
    "expect": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\r\nAA",
      "enc": "utf8"
    }
  },
  {
    "name": "encode soft break before an =XX that would not fit",
    "ref": "RFC 2045 section 6.7 rule 5; cross-checked with Python binascii.b2a_qp",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
      "enc": "utf8"
    },
    "expect": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\r\n=3D=3D",
      "enc": "utf8"
    }
  },
  {
    "name": "encode =XX ending exactly at 75 characters",
    "ref": "RFC 2045 section 6.7 rule 5; cross-checked with Python binascii.b2a_qp",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
      "enc": "utf8"
    },
    "expect": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=3D=\r\n=3D",
      "enc": "utf8"
    }
  },
  {
    "name": "encode 150 characters in two lines",
    "ref": "RFC 2045 section 6.7 rule 5; cross-checked with Python binascii.b2a_qp",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "enc": "utf8"
    },
    "expect": {
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=\r\nAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "enc": "utf8"
    }
  },
  {
    "name": "encode long line ending in white space",
    "ref": "RFC 2045 section 6.7 rules 3 and 5; cross-checked with Python binascii.b2a_qp",
    "op": "quotedprintable:encode",
    "params": {},
    "input": {
      "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx          y",
      "enc": "utf8"
    },
    "expect": {
      "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx     =\r\n     y",
      "enc": "utf8"
    }
  },
  {
    "name": "decode =3D and lower-case hex",
    "ref": "RFC 2045 section 6.7 (hex digits in either case are read)",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "hello=3Dworld=3d",
      "enc": "utf8"
    },
    "expect": {
      "value": "hello=world=",
      "enc": "utf8"
    }
  },
  {
    "name": "decode soft line breaks",
    "ref": "RFC 2045 section 6.7 rule 5 (= at line end)",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "foo=\r\nbar=\nbaz",
      "enc": "utf8"
    },
    "expect": {
      "value": "foobarbaz",
      "enc": "utf8"
    }
  },
  {
    "name": "decode strips trailing white space",
    "ref": "RFC 2045 section 6.7 section 6.7 (trailing white space is transport padding)",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a  \r\nb\t\nc ",
      "enc": "utf8"
    },
    "expect": {
      "value": "a\r\nb\nc",
      "enc": "utf8"
    }
  },
  {
    "name": "decode UTF-8 bytes",
    "ref": "RFC 2045 section 6.7; hand-computed (c3 a9)",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "caf=C3=A9",
      "enc": "utf8"
    },
    "expect": {
      "value": "café",
      "enc": "utf8"
    }
  },
  {
    "name": "decode empty input",
    "ref": "hand-computed",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "",
      "enc": "utf8"
    },
    "expect": {
      "value": "",
      "enc": "utf8"
    }
  },
  {
    "name": "decode binary bytes",
    "ref": "RFC 2045 section 6.7",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "=00=FF",
      "enc": "utf8"
    },
    "expect": {
      "value": "00ff",
      "enc": "hex"
    }
  },
  {
    "name": "decode soft break after kept white space",
    "ref": "RFC 2045 section 6.7 (white space before = is not trailing)",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a =\r\nb",
      "enc": "utf8"
    },
    "expect": {
      "value": "a b",
      "enc": "utf8"
    }
  },
  {
    "name": "decode 8-bit bytes literally",
    "ref": "Forge rule: other bytes stand for themselves",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "e9",
      "enc": "hex"
    },
    "expect": {
      "value": "e9",
      "enc": "hex"
    }
  },
  {
    "name": "decode = at the very end",
    "ref": "Forge rule: a final = is a soft break",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a=",
      "enc": "utf8"
    },
    "expect": {
      "value": "a",
      "enc": "utf8"
    }
  },
  {
    "name": "error: = and one digit",
    "ref": "Forge rule: = needs two hex digits",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a=4",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_COERCE"
    }
  },
  {
    "name": "error: = and non-hex",
    "ref": "Forge rule: = needs two hex digits",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a=zz",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_COERCE"
    }
  },
  {
    "name": "error: = then space",
    "ref": "Forge rule: = needs two hex digits",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a= b",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_COERCE"
    }
  },
  {
    "name": "error: == before a soft break",
    "ref": "Forge rule: the first = is malformed",
    "op": "quotedprintable:decode",
    "params": {},
    "input": {
      "value": "a==\r\n41",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_COERCE"
    }
  }
]
