[
  {
    "name": "encode all sixteen digits",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:encode",
    "params": {},
    "input": {
      "value": "0123456789abcdef",
      "enc": "hex"
    },
    "expect": {
      "value": "cbdefghijklnrtuv",
      "enc": "utf8"
    },
    "example": {
      "title": "Each hex digit has its own letter",
      "note": "Digit 0 is c and digit f is v, so the sixteen digits give sixteen letters."
    }
  },
  {
    "name": "decode all sixteen digits",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "cbdefghijklnrtuv",
      "enc": "utf8"
    },
    "expect": {
      "value": "0123456789abcdef",
      "enc": "hex"
    }
  },
  {
    "name": "encode ff",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:encode",
    "params": {},
    "input": {
      "value": "ff",
      "enc": "hex"
    },
    "expect": {
      "value": "vv",
      "enc": "utf8"
    }
  },
  {
    "name": "encode empty",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:encode",
    "params": {},
    "input": {
      "value": "",
      "enc": "utf8"
    },
    "expect": {
      "value": "",
      "enc": "utf8"
    }
  },
  {
    "name": "decode empty",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "",
      "enc": "utf8"
    },
    "expect": {
      "value": "",
      "enc": "utf8"
    }
  },
  {
    "name": "encode AB",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed (0x41 -> fb... 4=h 1=b)",
    "op": "modhex:encode",
    "params": {},
    "input": {
      "value": "AB",
      "enc": "utf8"
    },
    "expect": {
      "value": "fbfd",
      "enc": "utf8"
    },
    "example": {
      "title": "Two bytes as four letters",
      "note": "Each byte is two letters, so AB (41 42) gives fbfd."
    }
  },
  {
    "name": "encode with space delimiter",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:encode",
    "params": {
      "delimiter": "space"
    },
    "input": {
      "value": "AB",
      "enc": "utf8"
    },
    "expect": {
      "value": "fb fd",
      "enc": "utf8"
    },
    "example": {
      "title": "Spaces between the bytes",
      "note": "With the delimiter set to space, the two bytes read fb fd."
    }
  },
  {
    "name": "decode with spaces",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "fb fd",
      "enc": "utf8"
    },
    "expect": {
      "value": "AB",
      "enc": "utf8"
    },
    "example": {
      "title": "Spaces between letter pairs",
      "note": "White space is skipped, so fb fd decodes to AB."
    }
  },
  {
    "name": "decode upper case",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "FBFD",
      "enc": "utf8"
    },
    "expect": {
      "value": "AB",
      "enc": "utf8"
    }
  },
  {
    "name": "encode non-ASCII UTF-8 é",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:encode",
    "params": {},
    "input": {
      "value": "é",
      "enc": "utf8"
    },
    "expect": {
      "value": "relk",
      "enc": "utf8"
    }
  },
  {
    "name": "decode non-ASCII UTF-8 é",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "relk",
      "enc": "utf8"
    },
    "expect": {
      "value": "é",
      "enc": "utf8"
    }
  },
  {
    "name": "decode error: letter outside the alphabet",
    "ref": "spec (E_COERCE)",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "ca",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_COERCE"
    },
    "example": {
      "title": "A letter outside the alphabet",
      "note": "The letter a is not a ModHex letter, so ca is an error with E_COERCE."
    }
  },
  {
    "name": "decode error: odd number of letters",
    "ref": "spec (E_COERCE)",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "cbd",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_COERCE"
    },
    "example": {
      "title": "An odd number of letters",
      "note": "Each byte needs two letters, so cbd is an error with E_COERCE."
    }
  },
  {
    "name": "encode error: unknown delimiter",
    "ref": "spec (static choice)",
    "op": "modhex:encode",
    "params": {
