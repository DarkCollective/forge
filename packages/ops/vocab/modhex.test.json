[
  {
    "name": "encode all sixteen digits",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:encode",
    "params": {},
    "input": {
      "value": "0123456789abcdef",
      "enc": "hex"
    },
    "expect": {
      "value": "cbdefghijklnrtuv",
      "enc": "utf8"
    }
  },
  {
    "name": "decode all sixteen digits",
    "ref": "Yubico ModHex table (0123456789abcdef = cbdefghijklnrtuv), hand-computed",
    "op": "modhex:decode",
    "params": {},
    "input": {
      "value": "cbdefghijklnrtuv",
      "enc": "utf8"
    },
    "expect": {
      "value": "0123456789abcdef",
      "enc": "hex"
    }
  },
  {
    "name": "encode ff",
