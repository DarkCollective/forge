  {
    "name": "replace swaps two words with groups",
    "ref": "ECMAScript RegExp with the u flag (spec §4.1)",
    "op": "regex:replace",
    "params": {
      "pattern": "(\\w+) (\\w+)",
      "replacement": "$2, $1"
    },
    "input": {
      "value": "John Smith",
      "enc": "utf8"
    },
    "expect": {
      "value": "Smith, John",
      "enc": "utf8"
    }
  },
  {
    "name": "replace with named group and $& and $$",
    "ref": "ECMAScript RegExp with the u flag (spec §4.1)",
    "op": "regex:replace",
    "params": {
      "pattern": "(?<x>-)",
