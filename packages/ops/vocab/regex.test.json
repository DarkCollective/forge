  {
    "name": "test ^h is false for Hello",
    "ref": "ECMAScript RegExp with the u flag (spec §4.1)",
    "op": "regex:test",
    "params": {
      "pattern": "^h"
    },
    "input": {
      "value": "Hello",
      "enc": "utf8"
    },
    "expect": {
      "json": false
    }
  },
  {
    "name": "test ^h with i is true",
    "ref": "ECMAScript RegExp with the u flag (spec §4.1)",
    "op": "regex:test",
    "params": {
      "pattern": "^h",
      "flags": "i"
    },
    "input": {
      "value": "Hello",
      "enc": "utf8"
    },
    "expect": {
      "json": true
    }
  },
