  {
    "name": "Secret / Attack at dawn",
    "ref": "Wikipedia, RC4, test vectors",
    "op": "rc4:crypt",
    "params": {
      "key": {
        "value": "Secret",
        "enc": "utf8"
      }
    },
    "input": {
      "value": "Attack at dawn",
