  {
    "name": "encode a domain, only the non-ASCII labels",
    "ref": "independent: Python punycode codec (bücher -> bcher-kva, münchen -> mnchen-3ya) with RFC 3490 xn-- prefix",
    "op": "punycode:encode",
    "params": {},
    "input": {
      "value": "bücher.example.münchen",
      "enc": "utf8"
    },
    "expect": {
      "value": "xn--bcher-kva.example.xn--mnchen-3ya",
      "enc": "utf8"
    },
    "example": {
      "title": "Only the non-ASCII labels change",
      "note": "The labels bücher and münchen get an xn-- prefix; example is ASCII, so it is written as it is."
    }
  },
  {
    "name": "decode a domain, xn-- in any case",
    "ref": "independent: Python punycode codec; RFC 3490 ACE prefix",
    "op": "punycode:decode",
    "params": {
      "mode": "domain"
    },
    "input": {
      "value": "XN--bcher-kva.example.xn--mnchen-3ya",
      "enc": "utf8"
    },
    "expect": {
      "value": "bücher.example.münchen",
      "enc": "utf8"
    },
    "example": {
      "title": "xn-- in any case",
      "note": "Labels that start with xn-- are decoded in any case, and the other labels are kept as they are."
    }
  },
