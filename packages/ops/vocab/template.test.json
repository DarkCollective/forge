  {
    "name": "triple braces and & do not escape",
    "ref": "Handlebars 4.7.10 (the reference implementation of the language) run on the same data and template",
    "op": "template:render",
    "params": {
      "template": "{{{html}}}|{{& html}}"
    },
    "input": {
      "value": "{\"name\":\"World\",\"n\":0,\"t\":true,\"f\":false,\"s\":\"\",\"items\":[\"a\",\"b\",\"c\"],\"empty\":[],\"objs\":[{\"id\":1,\"tags\":[\"x\",\"y\"]},{\"id\":2,\"tags\":[]}],\"user\":{\"first\":\"Ann\",\"admin\":true,\"nested\":{\"deep\":\"d\"}},\"html\":\"<b>&\\\"'`=</b>\",\"num\":12.5,\"nul\":null,\"map\":{\"1\":\"one\",\"2\":\"two\",\"z\":\"zed\"}}",
