      "value": "00000000",
      "enc": "hex"
    },
    "expect": {
      "value": "z",
      "enc": "utf8"
    },
    "example": {
      "title": "Zero bytes shorten to z",
      "note": "Ascii85 writes a group of four zero bytes as the single letter z. Z85 does not do this (see the 00000 example)."
    }
  },
