  {
    "name": "z85 encode RFC 32 test frame",
    "ref": "ZeroMQ RFC 32 (Z85)",
    "op": "base85:encode",
    "params": {
      "variant": "z85"
    },
    "input": {
      "value": "864fd26fb559f75b",
      "enc": "hex"
    },
    "expect": {
      "value": "HelloWorld",
      "enc": "utf8"
    },
    "example": {
      "title": "Encode 8 bytes as Z85",
      "note": "With variant z85 the eight bytes give HelloWorld, the test frame of ZeroMQ RFC 32."
