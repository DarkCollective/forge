[
  {
    "name": "a table with an int, a str with a null and an empty string, and a bool",
    "ref": "the faithful text form (X0 R10): JSON with a column header and nulls, hand-written",
    "op": "table:from-text",
    "params": {},
    "input": {
      "value": "{\"columns\":[{\"name\":\"id\",\"type\":\"int\"},{\"name\":\"name\",\"type\":\"str\"},{\"name\":\"ok\",\"type\":\"bool\"}],\"rows\":[[1,\"Ada\",true],[2,\"\",false],[null,null,null]]}",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"id\",\"type\":\"int\"},{\"name\":\"name\",\"type\":\"str\"},{\"name\":\"ok\",\"type\":\"bool\"}],\"rows\":[[1,\"Ada\",true],[2,\"\",false],[null,null,null]]}"
      }
    },
    "example": {
      "title": "Read a table back from its text form",
      "note": "A null stays apart from the empty string, and an integer beyond 2^53 is written as a string of digits."
    }
  },
  {
    "name": "an integer beyond 2^53 written as digits is kept exactly, a num -0 is kept",
    "ref": "the faithful text form (X0 R10), 9007199254740993 is 2^53 + 1",
    "op": "table:from-text",
    "params": {},
    "input": {
      "value": "{\"columns\":[{\"name\":\"big\",\"type\":\"int\"},{\"name\":\"x\",\"type\":\"num\"}],\"rows\":[[\"9007199254740993\",-0],[\"-9223372036854775808\",1.5]]}",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"big\",\"type\":\"int\"},{\"name\":\"x\",\"type\":\"num\"}],\"rows\":[[\"9007199254740993\",-0],[\"-9223372036854775808\",1.5]]}"
      }
    }
  },
  {
    "name": "a table with no rows",
    "ref": "the faithful text form (X0 R10), hand-written",
    "op": "table:from-text",
    "params": {},
    "input": {
      "value": "{\"columns\":[{\"name\":\"a\",\"type\":\"str\"}],\"rows\":[]}",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"a\",\"type\":\"str\"}],\"rows\":[]}"
      }
    }
  },
  {
    "name": "text that is not a table",
