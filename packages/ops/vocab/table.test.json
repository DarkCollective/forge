      "enc": "utf8"
    },
    "expect": "pass"
  },
  {
    "name": "output: control bytes are not printable text",
    "op": "table:to-csv",
    "checks": "output",
    "data": {
      "value": "0102030405060708",
      "enc": "hex"
    },
    "expect": "fail"
  },
  {
    "name": "an array of records",
    "ref": "JSON (RFC 8259) and the table text form (X0 R10), hand-written",
    "op": "table:from-json",
    "params": {
      "header": true
    },
    "input": {
      "value": "[{\"id\":1,\"name\":\"Ada\",\"ok\":true},{\"id\":2,\"name\":\"Alan\",\"ok\":false}]",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"id\",\"type\":\"int\"},{\"name\":\"name\",\"type\":\"str\"},{\"name\":\"ok\",\"type\":\"bool\"}],\"rows\":[[1,\"Ada\",true],[2,\"Alan\",false]]}"
      }
    },
    "example": {
      "title": "Parse JSON records into a table",
      "note": "The columns are every key in the order first seen, and a record without a key has null there."
    }
  },
