[
  {
    "name": "encode foobar",
    "ref": "RFC 4648 §8 (base16) and spec §10.1",
    "op": "hex:encode",
    "params": {},
    "input": {
      "value": "foobar",
      "enc": "utf8"
    },
    "expect": {
      "value": "666f6f626172",
      "enc": "utf8"
    }
  },
  {
    "name": "encode empty input",
    "ref": "RFC 4648 §8 (base16) and spec §10.1",
    "op": "hex:encode",
    "params": {},
