[
  {
    "name": "strings: single bytes, minimum length 4",
    "ref": "hand-computed: runs of printable ASCII of 4 or more",
    "op": "extract:strings",
    "params": {
      "encoding": "single",
      "min-length": 4,
      "match": "printable",
      "null-terminated": false,
      "display-total": false,
      "sort": false,
      "unique": false
    },
    "input": {
      "value": "61620068656c6c6f00776f7200776f726c6421017878",
      "enc": "hex"
    },
    "expect": {
      "value": "hello\nworld!",
      "enc": "utf8"
    }
  },
  {
    "name": "strings: minimum length 3",
    "ref": "hand-computed: runs of printable ASCII of 3 or more",
