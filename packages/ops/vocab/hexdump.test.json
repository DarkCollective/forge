    },
    "expect": {
      "value": "",
      "enc": "utf8"
    }
  },
  {
    "name": "encode non-ASCII UTF-8 (é)",
    "ref": "xxd (macOS) output",
    "op": "hexdump:encode",
    "params": {},
    "input": {
      "value": "é",
      "enc": "utf8"
    },
    "expect": {
      "value": "00000000: c3a9                                     ..",
      "enc": "utf8"
    },
    "example": {
      "title": "Non-ASCII bytes as full stops",
      "note": "The two bytes of é show as two full stops in the ASCII column, because they are not printable ASCII."
    }
  },
