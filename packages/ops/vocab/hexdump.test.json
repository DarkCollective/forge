  {
    "name": "decode xxd output of text",
    "ref": "xxd (macOS) output",
    "op": "hexdump:decode",
    "params": {},
    "input": {
      "value": "00000000: 4865 6c6c 6f2c 2077 6f72 6c64 210a       Hello, world!.",
      "enc": "utf8"
    },
    "expect": {
      "value": "48656c6c6f2c20776f726c64210a",
      "enc": "hex"
    },
    "example": {
      "title": "Read an xxd dump back",
      "note": "The reverse of the default layout: the offsets and the ASCII column are ignored, and the hex comes back as bytes."
    }
  },
