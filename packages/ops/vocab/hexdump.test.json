[
  {
    "name": "encode text, default width",
    "ref": "xxd (macOS) output",
    "op": "hexdump:encode",
    "params": {},
    "input": {
      "value": "Hello, world!\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "00000000: 4865 6c6c 6f2c 2077 6f72 6c64 210a       Hello, world!.",
      "enc": "utf8"
    },
    "example": {
      "title": "The default layout",
      "note": "Each line has an 8-digit offset, the bytes as hex in pairs, and the ASCII column, where a byte that is not printable shows as a full stop."
    }
  },
  {
    "name": "encode binary, width 5 upper case",
    "ref": "xxd (macOS) output -c 5 -u",
    "op": "hexdump:encode",
    "params": {
      "width": 5,
      "case": "upper"
    },
    "input": {
      "value": "48656c6c6f2c20776f726c64210a00ff7f207e",
      "enc": "hex"
    },
    "expect": {
      "value": "00000000: 4865 6C6C 6F  Hello\n00000005: 2C20 776F 72  , wor\n0000000a: 6C64 210A 00  ld!..\n0000000f: FF7F 207E     .. ~",
      "enc": "utf8"
    }
  },
  {
    "name": "encode binary, width 8",
    "ref": "xxd (macOS) output -c 8",
    "op": "hexdump:encode",
    "params": {
      "width": 8
    },
    "input": {
      "value": "48656c6c6f2c20776f726c64210a00ff7f207e",
      "enc": "hex"
    },
    "expect": {
      "value": "00000000: 4865 6c6c 6f2c 2077  Hello, w\n00000008: 6f72 6c64 210a 00ff  orld!...\n00000010: 7f20 7e              . ~",
      "enc": "utf8"
    }
  },
  {
    "name": "encode width 8 without the ASCII column",
    "ref": "xxd -c 8 with the ASCII column removed by hand",
    "op": "hexdump:encode",
    "params": {
      "width": 8,
      "ascii": false
    },
    "input": {
      "value": "48656c6c6f2c20776f726c64210a00ff7f207e",
      "enc": "hex"
    },
    "expect": {
      "value": "00000000: 4865 6c6c 6f2c 2077\n00000008: 6f72 6c64 210a 00ff\n00000010: 7f20 7e",
      "enc": "utf8"
    },
    "example": {
      "title": "Without the ASCII column",
      "note": "With ascii off the text column is left out, so each line ends with its hex bytes."
    }
  },
  {
    "name": "encode empty",
