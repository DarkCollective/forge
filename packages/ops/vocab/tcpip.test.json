  {
    "name": "IPv4 header with its checksum verifies to zero",
    "ref": "Wikipedia, IPv4 header checksum worked example",
    "op": "tcpip:checksum",
    "params": {},
    "input": {
      "value": "45000073000040004011b861c0a80001c0a800c7",
      "enc": "hex"
    },
    "expect": {
      "value": "0000",
      "enc": "hex"
    }
  },
  {
    "name": "empty input",
    "ref": "RFC 1071: an empty sum is zero, complement ffff",
    "op": "tcpip:checksum",
    "params": {},
    "input": {
      "value": "",
      "enc": "hex"
    },
    "expect": {
      "value": "ffff",
      "enc": "hex"
    }
  },
  {
    "name": "odd length pads a zero byte on the right",
    "ref": "hand-computed: ff00 -> complement 00ff",
    "op": "tcpip:checksum",
    "params": {},
    "input": {
      "value": "ff",
      "enc": "hex"
    },
    "expect": {
      "value": "00ff",
      "enc": "hex"
    }
  },
  {
    "name": "carry folded twice",
    "ref": "hand-computed: every ffff word is zero in ones complement, so the sum folds to ffff and its complement is 0000",
    "op": "tcpip:checksum",
    "params": {},
    "input": {
      "value": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "enc": "hex"
    },
    "expect": {
      "value": "0000",
      "enc": "hex"
