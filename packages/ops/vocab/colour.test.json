[
  {
    "name": "hex orange",
    "ref": "CSS Color 4: #ff8000 is rgb(255 128 0), hsl(30 100% 50%) (hue 128/255 x 60 = 30.1 degrees)",
    "op": "colour:parse",
    "params": {},
    "input": {
      "value": "#ff8000",
      "enc": "utf8"
    },
    "expect": {
      "value": "Hex:   #ff8000\nRGB:   rgb(255, 128, 0)\nRGBA:  rgba(255, 128, 0, 1)\nHSL:   hsl(30, 100%, 50%)\nHSLA:  hsla(30, 100%, 50%, 1)\nCMYK:  cmyk(0%, 50%, 100%, 0%)",
      "enc": "utf8"
    }
  },
  {
    "name": "short hex without a hash",
    "ref": "CSS: #f80 is #ff8800; hue 136/255 x 60 = 32 degrees; magenta (255-136)/255 = 46.7 percent",
    "op": "colour:parse",
    "params": {},
    "input": {
      "value": "F80",
      "enc": "utf8"
    },
    "expect": {
      "value": "Hex:   #ff8800\nRGB:   rgb(255, 136, 0)\nRGBA:  rgba(255, 136, 0, 1)\nHSL:   hsl(32, 100%, 50%)\nHSLA:  hsla(32, 100%, 50%, 1)\nCMYK:  cmyk(0%, 47%, 100%, 0%)",
      "enc": "utf8"
    }
  },
  {
    "name": "hex with alpha",
