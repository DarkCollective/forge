    "expect": {
      "value": "Hex:   #ff8000\nRGB:   rgb(255, 128, 0)\nRGBA:  rgba(255, 128, 0, 1)\nHSL:   hsl(30, 100%, 50%)\nHSLA:  hsla(30, 100%, 50%, 1)\nCMYK:  cmyk(0%, 50%, 100%, 0%)",
      "enc": "utf8"
    }
  },
  {
    "name": "hsla with degrees",
    "ref": "hsla(210deg 50% 40% 0.5): C = 0.5 x 0.8 = 0.4, so channels 0.2, 0.4, 0.6 x 255 = 51, 102, 153; alpha 0.5 x 255 = 127.5 -> 128",
    "op": "colour:parse",
    "params": {},
    "input": {
      "value": "hsla(210deg 50% 40% 0.5)",
      "enc": "utf8"
    },
    "expect": {
      "value": "Hex:   #33669980\nRGB:   rgb(51, 102, 153)\nRGBA:  rgba(51, 102, 153, 0.5)\nHSL:   hsl(210, 50%, 40%)\nHSLA:  hsla(210, 50%, 40%, 0.5)\nCMYK:  cmyk(67%, 33%, 0%, 40%)",
      "enc": "utf8"
    }
  },
  {
    "name": "hue past 360 wraps",
    "ref": "hsl(390, 100%, 50%) is the same as hsl(30, 100%, 50%)",
    "op": "colour:parse",
    "params": {},
    "input": {
      "value": "hsl(390, 100%, 50%)",
      "enc": "utf8"
    },
    "expect": {
      "value": "Hex:   #ff8000\nRGB:   rgb(255, 128, 0)\nRGBA:  rgba(255, 128, 0, 1)\nHSL:   hsl(30, 100%, 50%)\nHSLA:  hsla(30, 100%, 50%, 1)\nCMYK:  cmyk(0%, 50%, 100%, 0%)",
      "enc": "utf8"
    }
  },
