      "value": "Hex:   #ff880088\nRGB:   rgb(255, 136, 0)\nRGBA:  rgba(255, 136, 0, 0.53)\nHSL:   hsl(32, 100%, 50%)\nHSLA:  hsla(32, 100%, 50%, 0.53)\nCMYK:  cmyk(0%, 47%, 100%, 0%)",
      "enc": "utf8"
    }
