      "value": "#ff800080",
      "enc": "utf8"
    },
    "expect": {
      "value": "Hex:   #ff800080\nRGB:   rgb(255, 128, 0)\nRGBA:  rgba(255, 128, 0, 0.5)\nHSL:   hsl(30, 100%, 50%)\nHSLA:  hsla(30, 100%, 50%, 0.5)\nCMYK:  cmyk(0%, 50%, 100%, 0%)",
      "enc": "utf8"
    }
  },
