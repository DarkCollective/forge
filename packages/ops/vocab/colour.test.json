      "enc": "utf8"
    }
  },
  {
    "name": "rgba with space and slash syntax",
    "ref": "CSS Color 4 allows rgb(10 20 30 / 0.25); alpha 0.25 x 255 = 63.75, rounded to 64 = 0x40; HSL of (10,20,30): hue 210, saturation 20/40 = 50 percent, lightness 40/510 = 7.8 percent",
    "op": "colour:parse",
    "params": {},
    "input": {
      "value": "RGBA(10 20 30 / 0.25)",
      "enc": "utf8"
    },
    "expect": {
      "value": "Hex:   #0a141e40\nRGB:   rgb(10, 20, 30)\nRGBA:  rgba(10, 20, 30, 0.25)\nHSL:   hsl(210, 50%, 8%)\nHSLA:  hsla(210, 50%, 8%, 0.25)\nCMYK:  cmyk(67%, 33%, 0%, 88%)",
      "enc": "utf8"
    }
  },
  {
    "name": "rgb with percentages",
    "ref": "100% is 255",
