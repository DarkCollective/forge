[
  {
    "name": "encode: a 16-byte name (the name used in the RFC 1001 examples)",
    "ref": "Python: the nibbles of RFC 1001 section 14.1 plus 65",
    "op": "netbios:encode",
    "params": {
      "offset": 65
    },
    "input": {
      "value": "The NetBIOS name",
      "enc": "utf8"
    },
    "expect": {
      "value": "FEGIGFCAEOGFHEECEJEPFDCAGOGBGNGF",
      "enc": "utf8"
    },
    "example": {
      "title": "The RFC 1001 name encoded",
      "note": "Each byte of the padded 16-byte name becomes two letters from A to P, so the output has 32 letters."
    }
  },
  {
    "name": "decode: the same name",
    "ref": "Python: the nibbles of RFC 1001 section 14.1 minus 65",
    "op": "netbios:decode",
    "params": {
      "offset": 65
    },
    "input": {
      "value": "FEGIGFCAEOGFHEECEJEPFDCAGOGBGNGF",
      "enc": "utf8"
    },
    "expect": {
      "value": "The NetBIOS name",
      "enc": "utf8"
    },
    "example": {
      "title": "Decode the RFC 1001 example name",
      "note": "Each pair of letters gives one byte, and the trailing spaces of the padding are removed."
    }
  },
  {
    "name": "encode: 'FRED' is padded with spaces to 16 bytes",
    "ref": "Python: nibble plus 65 on the name padded with spaces",
    "op": "netbios:encode",
    "params": {},
    "input": {
      "value": "FRED",
      "enc": "utf8"
    },
    "expect": {
      "value": "EGFCEFEECACACACACACACACACACACACA",
      "enc": "utf8"
    },
    "example": {
      "title": "A short name is padded with spaces",
      "note": "FRED is padded with spaces to 16 bytes before it is encoded, so the output is 32 letters, most of them for the padding."
    }
  },
