  {
    "name": "default widths (1 and 1)",
    "ref": "elements assembled with Python struct/int.to_bytes from (tag, value) lists; expected JSON written from the same lists",
    "op": "tlv:parse",
    "params": {
      "tag-bytes": 1,
      "length-bytes": 1,
      "ber": false,
      "indent": 0
    },
    "input": {
      "value": "0102aabb0200ff0a00010203040506070809",
      "enc": "hex"
    },
    "expect": {
      "value": "[{\"type\":\"01\",\"length\":2,\"value\":\"aabb\"},{\"type\":\"02\",\"length\":0,\"value\":\"\"},{\"type\":\"ff\",\"length\":10,\"value\":\"00010203040506070809\"}]",
      "enc": "utf8"
    }
  },
