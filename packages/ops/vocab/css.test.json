[
  {
    "name": "type selector",
    "ref": "lxml.html with cssselect",
    "op": "css:select",
    "params": {
      "css-selector": "h1",
      "delimiter": "\\n"
    },
    "input": {
      "value": "<!DOCTYPE html>\n<html><head><title>Test page</title></head>\n<body>\n<div id=\"main\" class=\"wrap big\">\n  <h1>Heading</h1>\n  <p class=\"intro\">First <b>bold</b> &amp; text</p>\n  <p>Second paragraph<br>after a break</p>\n  <ul id=\"list\"><li class=\"a\">one</li><li class=\"b a\">two</li><li>three</li><li class=\"a last\">four</li></ul>\n  <a href=\"https://example.com/x\" title=\"X\">link x</a>\n  <a href=\"/local/y\">link y</a>\n  <img src=\"pic.png\" alt=\"a picture\">\n</div>\n<div class=\"footer\"><span>f1</span><span>f2</span></div>\n</body></html>",
      "enc": "utf8"
    },
    "expect": {
      "value": "<h1>Heading</h1>",
      "enc": "utf8"
    },
    "example": {
      "title": "A type selector returns the whole element",
      "note": "The outer HTML of the matching element is written, its tags included."
    }
  },
