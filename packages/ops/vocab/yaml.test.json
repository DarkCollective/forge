  {
    "name": "strings with indicators and edge spaces are quoted",
    "ref": "hand-written to the layout of js-yaml's dump defaults; reads back with PyYAML safe_load to the same value",
    "op": "yaml:from-json",
    "params": {},
    "input": {
      "value": "[\"a: b\",\"- x\",\"  lead\",\"trail \",\"#c\",\"@a\",\"!x\",\"&a\",\"*a\",\"%a\",\"a #b\",\"a: \",\"[x]\",\"{y}\",\"?\"]",
      "enc": "utf8"
