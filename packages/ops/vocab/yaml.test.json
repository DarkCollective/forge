[
  {
    "name": "mapping with scalars, a flow list and a nested block",
    "ref": "PyYAML safe_load and json.dumps",
    "op": "yaml:to-json",
    "params": {
      "indent": 4
    },
    "input": {
      "value": "name: Ada\nage: 36\nratio: 2.5\nactive: true\nnothing: null\ntilde: ~\nempty:\nlist: [1, 2, 3]\nnested:\n  a: 1\n  b:\n    - x\n    - y\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "{\n    \"name\": \"Ada\",\n    \"age\": 36,\n    \"ratio\": 2.5,\n    \"active\": true,\n    \"nothing\": null,\n    \"tilde\": null,\n    \"empty\": null,\n    \"list\": [\n        1,\n        2,\n        3\n    ],\n    \"nested\": {\n        \"a\": 1,\n        \"b\": [\n            \"x\",\n            \"y\"\n        ]\n    }\n}",
      "enc": "utf8"
    }
  },
  {
    "name": "compact output (indent 0)",
    "ref": "PyYAML safe_load and json.dumps",
    "op": "yaml:to-json",
    "params": {
      "indent": 0
    },
    "input": {
      "value": "a: 1\nb: [x, y]\nc:\n  d: null\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "{\"a\":1,\"b\":[\"x\",\"y\"],\"c\":{\"d\":null}}",
      "enc": "utf8"
    }
  },
  {
    "name": "indent 2",
    "ref": "PyYAML safe_load and json.dumps",
    "op": "yaml:to-json",
    "params": {
      "indent": 2
    },
    "input": {
      "value": "a: 1\nb: [x, y]\nc:\n  d: null\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "{\n  \"a\": 1,\n  \"b\": [\n    \"x\",\n    \"y\"\n  ],\n  \"c\": {\n    \"d\": null\n  }\n}",
      "enc": "utf8"
    }
  },
  {
    "name": "sequence of mappings",
    "ref": "PyYAML safe_load and json.dumps",
    "op": "yaml:to-json",
    "params": {
      "indent": 4
    },
    "input": {
      "value": "- id: 1\n  tags: [a, b]\n- id: 2\n  tags: []\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "[\n    {\n        \"id\": 1,\n        \"tags\": [\n            \"a\",\n            \"b\"\n        ]\n    },\n    {\n        \"id\": 2,\n        \"tags\": []\n    }\n]",
      "enc": "utf8"
    }
  },
  {
    "name": "quoted strings and escapes",
    "ref": "PyYAML safe_load and json.dumps",
    "op": "yaml:to-json",
    "params": {
      "indent": 4
    },
    "input": {
      "value": "a: 'it''s'\nb: \"tab\\there \\u00e9 \\x41\"\nc: \"line\\nbreak\"\nd: 'plain # not a comment'\ne: x # comment\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "{\n    \"a\": \"it's\",\n    \"b\": \"tab\\there é A\",\n    \"c\": \"line\\nbreak\",\n    \"d\": \"plain # not a comment\",\n    \"e\": \"x\"\n}",
      "enc": "utf8"
    }
  },
  {
    "name": "block scalars: literal, folded, strip and keep",
    "ref": "PyYAML safe_load and json.dumps",
    "op": "yaml:to-json",
    "params": {
      "indent": 4
    },
    "input": {
      "value": "lit: |\n  line1\n  line2\nfold: >\n  folded\n  text\n\n  para\nstrip: |-\n  no newline\nkeep: |+\n  kept\n\nafter: 1\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "{\n    \"lit\": \"line1\\nline2\\n\",\n    \"fold\": \"folded text\\npara\\n\",\n    \"strip\": \"no newline\",\n    \"keep\": \"kept\\n\\n\",\n    \"after\": 1\n}",
      "enc": "utf8"
    }
  },
