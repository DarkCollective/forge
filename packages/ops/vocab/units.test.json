    "ref": "-0.0000001 rounded to 3 decimal places is 0 (no negative zero)",
    "op": "units:convert-distance",
    "params": {
      "from": "metre",
      "to": "metre",
      "digits": 3
    },
    "input": {
      "value": "-0.0000001",
      "enc": "utf8"
    },
    "expect": {
      "value": "0",
      "enc": "utf8"
    }
  },
