[
  {
    "name": "geohash of the middle of ezs42",
    "ref": "Wikipedia, Geohash: ezs42 is the cell around 42.605, -5.603; its exact middle (bisection in floating point, computed independently) encodes back to it",
    "op": "coords:convert",
    "params": {
      "from": "auto",
      "to": "geohash",
      "precision": 5
    },
    "input": {
      "value": "42.60498046875, -5.60302734375",
      "enc": "utf8"
    },
    "expect": {
      "value": "ezs42",
      "enc": "utf8"
    }
  },
  {
    "name": "geohash ezs42 to decimal degrees",
    "ref": "Wikipedia, Geohash: ezs42 decodes to 42.605, -5.603; the exact middle of the cell is 42.60498046875, -5.60302734375",
    "op": "coords:convert",
    "params": {
      "from": "auto",
      "to": "decimal-degrees",
      "precision": 6
    },
    "input": {
      "value": "ezs42",
      "enc": "utf8"
    },
    "expect": {
      "value": "42.604980, -5.603027",
      "enc": "utf8"
    }
  },
