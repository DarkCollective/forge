[
  {
    "name": "even parity at the end",
    "ref": "definition: 1011 has three 1 bits, so the parity bit is 1",
    "op": "parity:encode",
    "params": {
      "mode": "even",
      "position": "end",
      "delimiter": ""
    },
    "input": {
      "value": "1011",
      "enc": "utf8"
    },
    "expect": {
      "value": "10111",
      "enc": "utf8"
    },
    "example": {
      "title": "Even parity at the end of 1011",
      "note": "1011 has three 1 bits, so the added bit is 1, which makes the count even: 10111."
    }
  },
  {
    "name": "even parity at the start",
    "ref": "definition",
