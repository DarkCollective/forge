  {
    "name": "blocks with a delimiter",
    "ref": "CyberChef ParityBit.mjs: each block gets its own bit",
    "op": "parity:encode",
    "params": {
      "mode": "even",
      "position": "end",
      "delimiter": ","
    },
    "input": {
      "value": "1011,0000,1111",
      "enc": "utf8"
    },
    "expect": {
      "value": "10111,00000,11110",
      "enc": "utf8"
    },
    "example": {
      "title": "Each block gets its own parity bit",
      "note": "The delimiter splits the text at each comma, so 1011, 0000 and 1111 each get one bit, and the commas stay."
    }
  },
