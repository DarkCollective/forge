[
  {
    "name": "upper straße gives STRASSE",
    "ref": "Unicode default case mapping (String.prototype), spec §10.1",
    "op": "text:upper",
    "params": {},
    "input": {
      "value": "straße",
      "enc": "utf8"
    },
    "expect": {
      "value": "STRASSE",
      "enc": "utf8"
    }
  },
  {
