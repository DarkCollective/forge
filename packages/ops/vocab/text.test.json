    "ref": "Unicode default case mapping (String.prototype), spec §10.1",
    "op": "text:upper",
    "params": {},
    "input": {
      "value": "àé",
      "enc": "utf8"
    },
    "expect": {
      "value": "ÀÉ",
      "enc": "utf8"
    }
  },
