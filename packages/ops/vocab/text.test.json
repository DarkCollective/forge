  {
    "name": "replace every b, all defaults to true",
    "ref": "hand-computed: abcabc with b replaced by X is aXcaXc",
    "op": "text:replace",
    "params": {
      "find": "b",
      "replacement": "X"
    },
    "input": {
      "value": "abcabc",
      "enc": "utf8"
    },
    "expect": {
      "value": "aXcaXc",
      "enc": "utf8"
    }
  },
  {
    "name": "replace first occurrence only with all false",
    "ref": "hand-computed: abcabc with the first b replaced by X is aXcabc",
    "op": "text:replace",
    "params": {
      "find": "b",
      "replacement": "X",
      "all": false
    },
    "input": {
      "value": "abcabc",
      "enc": "utf8"
    },
    "expect": {
      "value": "aXcabc",
      "enc": "utf8"
    }
  },
  {
    "name": "replace with no match leaves the text unchanged",
    "ref": "hand-computed: no z in abc",
    "op": "text:replace",
    "params": {
      "find": "z",
      "replacement": "Q"
    },
    "input": {
      "value": "abc",
      "enc": "utf8"
    },
    "expect": {
      "value": "abc",
      "enc": "utf8"
    }
  },
  {
    "name": "replacement is literal, not an ECMAScript substitution",
    "ref": "hand-computed: bab with a replaced by the literal $&$$ is b$&$$b",
    "op": "text:replace",
    "params": {
      "find": "a",
      "replacement": "$&$$"
    },
    "input": {
      "value": "bab",
      "enc": "utf8"
    },
    "expect": {
      "value": "b$&$$b",
      "enc": "utf8"
    }
  },
  {
    "name": "find is literal, a dot is not a wildcard",
    "ref": "hand-computed: only the one literal dot in a.bxc is replaced",
    "op": "text:replace",
    "params": {
      "find": ".",
      "replacement": "-"
    },
    "input": {
      "value": "a.bxc",
      "enc": "utf8"
    },
    "expect": {
      "value": "a-bxc",
      "enc": "utf8"
    }
  },
  {
    "name": "empty find is a static recipe error",
    "ref": "static check: find is str[1..]",
    "op": "text:replace",
    "params": {
      "find": "",
      "replacement": "b"
    },
    "input": {
      "value": "abc",
      "enc": "utf8"
    },
    "expect": {
      "error": "E_RECIPE_INVALID"
    }
  },
  {
    "name": "replace of empty input is empty",
