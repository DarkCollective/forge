  {
    "name": "decode payload, RFC 7515 A.1",
    "ref": "RFC 7515 appendix A.1 (JWS using HMAC SHA-256)",
    "op": "jwt:decode",
    "params": {
      "part": "payload"
    },
    "input": {
      "value": "eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ.dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
      "enc": "utf8"
    },
    "expect": {
      "value": "{\"iss\":\"joe\",\r\n \"exp\":1300819380,\r\n \"http://example.com/is_root\":true}",
      "enc": "utf8"
    },
    "example": {
      "title": "Read the claims of a signed token (RFC 7515 example)",
      "note": "The middle part is Base64url of the claims, a JSON object. iss is the issuer and exp the expiry as a Unix time. The text is returned exactly as it was signed."
    }
  },
