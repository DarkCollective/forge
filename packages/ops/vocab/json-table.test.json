    "params": {
      "header": false
    },
    "input": {
      "value": "[[1,\"Ada\"],[2,\"Alan\"]]",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"c1\",\"type\":\"int\"},{\"name\":\"c2\",\"type\":\"str\"}],\"rows\":[[1,\"Ada\"],[2,\"Alan\"]]}"
      }
    }
  },
  {
    "name": "one record is one row",
    "ref": "JSON (RFC 8259) and the table text form (X0 R10), hand-written",
