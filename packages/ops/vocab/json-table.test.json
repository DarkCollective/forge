  {
    "name": "NDJSON: one record on each line",
    "ref": "NDJSON (JSON Lines), hand-written",
    "op": "json-table:parse-ndjson",
    "params": {
      "header": true
    },
    "input": {
      "value": "{\"a\":1,\"b\":\"x\"}\n\n{\"a\":2}\n{\"b\":null,\"c\":true}\n",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"a\",\"type\":\"int\"},{\"name\":\"b\",\"type\":\"str\"},{\"name\":\"c\",\"type\":\"bool\"}],\"rows\":[[1,\"x\",null],[2,null,null],[null,null,true]]}"
      }
    },
    "example": {
      "title": "Parse newline-delimited JSON",
      "note": "One record on each line. Blank lines are skipped."
    }
  },
  {
    "name": "NDJSON: lines that are arrays",
    "ref": "NDJSON (JSON Lines), hand-written",
    "op": "json-table:parse-ndjson",
    "params": {
      "header": true
    },
    "input": {
      "value": "[\"a\",\"b\"]\n[1,2]\n[3,4]",
