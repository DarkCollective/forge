[
  {
    "name": "an array of records",
    "ref": "JSON (RFC 8259) and the table text form (X0 R10), hand-written",
    "op": "json-table:parse",
    "params": {
      "header": true
    },
    "input": {
      "value": "[{\"id\":1,\"name\":\"Ada\",\"ok\":true},{\"id\":2,\"name\":\"Alan\",\"ok\":false}]",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"id\",\"type\":\"int\"},{\"name\":\"name\",\"type\":\"str\"},{\"name\":\"ok\",\"type\":\"bool\"}],\"rows\":[[1,\"Ada\",true],[2,\"Alan\",false]]}"
      }
    },
    "example": {
      "title": "Parse JSON records into a table",
      "note": "The columns are every key in the order first seen, and a record without a key has null there."
    }
  },
  {
    "name": "a missing key and a JSON null are null cells",
    "ref": "JSON (RFC 8259) and the table text form (X0 R10), hand-written",
    "op": "json-table:parse",
    "params": {
      "header": true
    },
    "input": {
      "value": "[{\"a\":1,\"b\":\"x\"},{\"b\":\"\",\"c\":null},{\"a\":2.5}]",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"a\",\"type\":\"num\"},{\"name\":\"b\",\"type\":\"str\"},{\"name\":\"c\",\"type\":\"str\"}],\"rows\":[[1,\"x\",null],[null,\"\",null],[2.5,null,null]]}"
      }
    }
  },
  {
    "name": "an array of arrays with a header row",
    "ref": "JSON (RFC 8259) and the table text form (X0 R10), hand-written",
    "op": "json-table:parse",
    "params": {
      "header": true
    },
    "input": {
      "value": "[[\"id\",\"name\"],[1,\"Ada\"],[2,null]]",
      "enc": "utf8"
    },
    "expect": {
      "json": {
        "$ext": "table",
        "text": "{\"columns\":[{\"name\":\"id\",\"type\":\"int\"},{\"name\":\"name\",\"type\":\"str\"}],\"rows\":[[1,\"Ada\"],[2,null]]}"
      }
    },
    "example": {
      "title": "Parse an array of arrays",
      "note": "The first array names the columns. With the header off they are c1, c2 and so on."
    }
  },
  {
    "name": "an array of arrays without a header",
    "ref": "JSON (RFC 8259) and the table text form (X0 R10), hand-written",
