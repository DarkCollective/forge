  {
    "name": "to-hex: a public key (Ed25519)",
    "ref": "openssl pkey -pubout (PEM) and -outform DER (the hex)",
    "op": "pem:to-hex",
    "params": {},
    "input": {
      "value": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAzWoAM2jJW81RvPv97zModKyWy688Stb8EByUS28dSJM=\n-----END PUBLIC KEY-----\n",
      "enc": "utf8"
    },
    "expect": {
      "value": "302a300506032b6570032100cd6a003368c95bcd51bcfbfdef332874ac96cbaf3c4ad6fc101c944b6f1d4893",
      "enc": "utf8"
    },
    "example": {
      "title": "Decode a PEM public key to DER bytes (as hex)",
      "note": "30 2a 30 05 06 03 2b 65 70 ... is the DER of an Ed25519 public key. Paste it into asn1-dump:parse to see its structure."
    }
  },
