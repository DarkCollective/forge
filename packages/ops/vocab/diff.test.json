[
  {
    "name": "diff: a changed line",
    "ref": "hand-computed from the definition in the doc string",
    "op": "diff:compare",
    "params": {
      "sample-delimiter": "\n\n",
      "by": "line",
      "ignore-whitespace": false,
      "context": 3
    },
    "input": {
      "value": "a\nb\nc\nd\n\na\nB\nc\nd",
      "enc": "utf8"
    },
    "expect": {
      "value": "--- sample 1\n+++ sample 2\n@@ -1,4 +1,4 @@\n a\n-b\n+B\n c\n d",
      "enc": "utf8"
    }
  },
