      "enc": "utf8"
    },
    "expect": {
      "value": "--- sample 1\n+++ sample 2\n@@ -1,4 +1,4 @@\n a\n-b\n+B\n c\n d\n@@ -15,2 +15,3 @@\n o\n p\n+q",
      "enc": "utf8"
    }
