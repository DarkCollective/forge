{
  "name": "@forge/ops",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/sources-node.d.ts",
      "default": "./dist/sources-node.js"
    },
    "./vite": {
      "types": "./dist/sources-vite.d.ts",
      "default": "./dist/sources-vite.js"
    },
    "./catalogue.json": "./dist/catalogue.json",
    "./catalogue.schema.json": "./dist/catalogue.schema.json",
    "./help.json": "./dist/help.json",
    "./help.schema.json": "./dist/help.schema.json"
  },
  "files": [
    "dist",
    "src",
    "vocab"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node dist-scripts/catalogue.js && node dist-scripts/help.js",
    "hash-snapshot": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node dist-scripts/hash-snapshot.js",
    "dupes": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node dist-scripts/dupes.js",
    "coverage": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node dist-scripts/catalogue.js && node dist-scripts/coverage.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@forge/lang": "*",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@xmldom/xmldom": "0.9.12",
    "css-select": "7.0.0",
    "dom-serializer": "3.1.1",
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "htmlparser2": "12.0.0",
    "json-p3": "3.0.1",
    "jsonata": "2.2.2",
    "lz-string": "1.5.0",
    "lzma1": "0.6.1",
    "xpath": "0.0.35",
    "yaml": "2.9.1"
  }
}
